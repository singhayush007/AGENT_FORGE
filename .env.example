# Postgres connection string (local Postgres, Neon, Prisma Postgres, ...)
# Hosted databases: add ?sslmode=verify-full
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agent_builder"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app (https://github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Runs the agents
OPENAI_API_KEY=""

# Optional: powers the Web Search and Read Webpage tools (https://tavily.com)
TAVILY_API_KEY=""

# Optional: use a free OpenAI-compatible provider instead of OpenAI
# (put the provider's key in OPENAI_API_KEY above)
# Groq:   OPENAI_BASE_URL="https://api.groq.com/openai/v1"  LLM_MODEL="llama-3.3-70b-versatile"
# Gemini: OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"  LLM_MODEL="gemini-2.5-flash"
OPENAI_BASE_URL=""
LLM_MODEL=""
